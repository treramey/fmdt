{
  "name": "fmdt",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "description": "CLI tool for tracking branch merge status across repositories",
  "license": "MIT",
  "author": "treramey <trevor@trevors.email>",
  "repository": {
    "type": "git",
    "url": "https://github.com/treramey/fmdt.git"
  },
  "homepage": "https://github.com/treramey/fmdt#readme",
  "bugs": {
    "url": "https://github.com/treramey/fmdt/issues"
  },
  "keywords": [
    "azure-devops",
    "github",
    "cli",
    "command-line",
    "cli-tool",
    "terminal",
    "tui",
    "branch-status",
    "merge-status",
    "developer-tools",
    "fmdt"
  ],
  "engines": {
    "node": ">=20.19.3"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": "./packages/cli/dist/index.js",
  "files": [
    "packages/cli/dist"
  ],
  "scripts": {
    "build": "bun run --cwd packages/cli build",
    "start": "bun run packages/cli/src/index.ts",
    "dev": "bun --watch packages/cli/src/index.ts",
    "test": "CI=true vitest run",
    "test:watch": "CI=true vitest --watch",
    "typecheck": "tsgo --noEmit",
    "check": "biome check --config-path=\"$(pwd)/biome.jsonc\" .",
    "check:write": "biome check --config-path=\"$(pwd)/biome.jsonc\" --write .",
    "check:unsafe": "biome check --config-path=\"$(pwd)/biome.jsonc\" --write --unsafe .",
    "ci": "concurrently --kill-others-on-fail --success all -n \"check,typecheck,test\" -c \"green,yellow,blue\" \"bun run check\" \"bun run typecheck\" \"bun run test\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "@types/bun": "^1.2.18",
    "@typescript/native-preview": "7.0.0-dev.20250712.1",
    "concurrently": "^9.2.0",
    "fs-fixture": "^2.8.1",
    "tsdown": "^0.12.9",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@latest"
  },
  "dependencies": {
    "zod": "^4.0.5"
  }
}
